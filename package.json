{
  "name": "@kulebbb/dsh-context-optimize",
  "version": "0.2.0",
  "description": "DSH 左侧边栏「Skill 管理」：按调用频次与上下文占用查看全局 / 项目级 skill，支持可逆归档与还原。",
  "license": "MIT",
  "author": "kulebbb",
  "homepage": "https://github.com/kulebbb/dsh-context-optimize#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kulebbb/dsh-context-optimize.git"
  },
  "bugs": {
    "url": "https://github.com/kulebbb/dsh-context-optimize/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "skills",
    "context"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
